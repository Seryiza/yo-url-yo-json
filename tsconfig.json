{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["bun-types"],
    "outDir": "dist"
  },
  "include": ["commands/**/*.ts", "src/**/*.ts", "dev-scripts/**/*.ts", "tests/**/*.ts"]
}
